<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">
    <display-name>TA Recruitment System</display-name>

    <servlet>
        <servlet-name>ADLogServlet</servlet-name>
        <servlet-class>com.bupt.tarecruit.controller.ADLogServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ADLogServlet</servlet-name>
        <url-pattern>/ad/logs</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ADLogRecordServlet</servlet-name>
        <servlet-class>com.bupt.tarecruit.controller.ADLogRecordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ADLogRecordServlet</servlet-name>
        <url-pattern>/ad/logs/record</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
